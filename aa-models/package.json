{
	"name": "@jeffreyjyz/aa-models",
	"version": "0.1.1",
	"description": "Artificial Analysis model catalogue as a CLI: list, filter, sort and emit the full record as JSON",
	"license": "MIT",
	"type": "module",
	"bin": {
		"aam": "src/index.ts",
		"aamdev": "src/index.ts"
	},
	"exports": {
		".": "./src/lib.ts",
		"./package.json": "./package.json"
	},
	"imports": {
		"#~/*": "./src/*"
	},
	"files": [
		"src",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"test": "bun test",
		"lint": "biome lint --write .",
		"typecheck": "bun check",
		"dev:link": "ln -sfn \"$PWD/src/index.ts\" \"$HOME/.bun/bin/aamdev\""
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "latest",
		"typescript": "^7"
	},
	"dependencies": {
		"cac": "^7.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JeffreyJYZ/cmdcode-tools.git",
		"directory": "aa-models"
	},
	"bugs": {
		"url": "https://github.com/JeffreyJYZ/cmdcode-tools/issues"
	},
	"homepage": "https://github.com/JeffreyJYZ/cmdcode-tools/tree/main/aa-models#readme"
}
