{
	"name": "@jeffreyjyz/opencode-context",
	"version": "0.1.2",
	"description": "Context-window breakdown for opencode: a /context dialog plus a context_breakdown tool showing where the window went (system prompt, tool definitions, thinking, tool I/O, messages), delta.app style.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./tui": "./dist/tui.js"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --external @opencode/plugin && bun scripts/build-tui.ts && tsc -p tsconfig.build.json",
		"test": "bun test",
		"lint": "biome lint --write .",
		"typecheck": "bun check"
	},
	"dependencies": {
		"@opentui/core": "0.5.12",
		"@opentui/solid": "0.5.12",
		"solid-js": "1.9.12"
	},
	"devDependencies": {
		"@opencode/plugin": "^2.0.11",
		"@types/bun": "latest",
		"typescript": "^7"
	},
	"files": [
		"dist",
		"index.js",
		"tui.js",
		"LICENSE"
	],
	"keywords": [
		"opencode",
		"opencode-plugin",
		"context",
		"tokens"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JeffreyJYZ/cmdcode-tools.git",
		"directory": "opencode-context"
	},
	"homepage": "https://github.com/JeffreyJYZ/cmdcode-tools/tree/main/opencode-context#readme",
	"bugs": {
		"url": "https://github.com/JeffreyJYZ/cmdcode-tools/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
