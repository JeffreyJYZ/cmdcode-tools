{
	"name": "@jeffreyjyz/reqshape",
	"version": "0.1.1",
	"description": "Measure the shape of your requests from opencode's own history, then price it against any model",
	"license": "MIT",
	"type": "module",
	"bin": {
		"reqshape": "src/index.ts",
		"reqshapedev": "src/index.ts"
	},
	"files": [
		"src",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"test": "bun test",
		"fmt": "biome format --write .",
		"check": "biome check --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "latest",
		"typescript": "^7"
	},
	"dependencies": {
		"cac": "^7.0.0"
	}
}
