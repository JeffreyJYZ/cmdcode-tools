{
	"name": "@jeffreyjyz/reqshape",
	"version": "0.2.0",
	"description": "Measure the shape of your requests from opencode's own history, then price it against any model",
	"license": "MIT",
	"type": "module",
	"bin": {
		"reqshape": "src/index.ts",
		"reqshapedev": "src/index.ts"
	},
	"imports": {
		"#~/*": "./src/*"
	},
	"files": [
		"src",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"start": "bun run src/index.ts",
		"test": "bun test",
		"lint": "biome lint --write .",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/bun": "latest"
	},
	"dependencies": {
		"cac": "^7.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JeffreyJYZ/cmdcode-tools.git",
		"directory": "reqshape"
	},
	"bugs": {
		"url": "https://github.com/JeffreyJYZ/cmdcode-tools/issues"
	},
	"homepage": "https://github.com/JeffreyJYZ/cmdcode-tools/tree/main/reqshape#readme"
}
