{
	"name": "@jeffreyjyz/opencode-shell-rc",
	"version": "0.4.1",
	"description": "Make the opencode agent shell load your zsh aliases and functions (via a fast ZDOTDIR shim), without paying for oh-my-zsh/compinit on every command.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "rm -rf dist && bun build src/index.ts --outdir dist --target bun --external @opencode/plugin && tsc -p tsconfig.build.json",
		"test": "bun test",
		"lint": "biome lint --write .",
		"typecheck": "bun check"
	},
	"devDependencies": {
		"@opencode/plugin": "^2.0.11",
		"@types/bun": "latest",
		"typescript": "^7"
	},
	"files": [
		"dist",
		"index.js",
		"LICENSE"
	],
	"keywords": [
		"opencode",
		"opencode-plugin",
		"zsh",
		"zdotdir",
		"aliases"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JeffreyJYZ/cmdcode-tools.git",
		"directory": "opencode-shell-rc"
	},
	"homepage": "https://github.com/JeffreyJYZ/cmdcode-tools/tree/main/opencode-shell-rc#readme",
	"bugs": {
		"url": "https://github.com/JeffreyJYZ/cmdcode-tools/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
